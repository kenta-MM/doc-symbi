{
  "name": "docsymbi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host localhost --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-service-worker.mjs",
    "build:test": "vite build --mode integration && node scripts/build-service-worker.mjs .test-build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e --project=e2e-offline",
    "test:performance": "playwright test --project=performance"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
