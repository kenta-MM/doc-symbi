{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "DocSymbi: F5で起動",
            "runtimeExecutable": "node",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/.tools/node-v22.23.4-win-x64/node.exe"
            },
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["--host", "localhost", "--port", "5173", "--strictPort"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "outputCapture": "std",
            "skipFiles": ["<node_internals>/**"],
            "env": { "NO_COLOR": "1" },
            "serverReadyAction": {
                "pattern": "Local:\\s+(http://localhost:5173/)",
                "uriFormat": "%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}",
                "killOnServerStop": true
            }
        }
    ]
}
